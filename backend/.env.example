# PostgreSQL connection pooler string (from Supabase Database settings)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Admin Dashboard secret key for protected routes
ADMIN_SECRET_KEY=your_secure_admin_password_here

# Optional CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://codeshield2026.vercel.app
