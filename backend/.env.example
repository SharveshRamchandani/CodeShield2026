# PostgreSQL Database Connection String (Supabase pooler connection recommended)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# JWT Authentication Config
JWT_SECRET=your_super_secret_random_64_char_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Confirmation Email Provider Configuration
# Set MAIL_PROVIDER="gmail_api" for production (Render) or "smtp" for local mail dev
MAIL_PROVIDER=gmail_api
MAIL_FROM=your_authorized_email@gmail.com

# Google OAuth2 Credentials for Gmail API (and Google Identity Services)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX_your_client_secret_here
GOOGLE_REFRESH_TOKEN=1//your_oauth_refresh_token_here

# Local Dev SMTP Settings (Used only when MAIL_PROVIDER=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=False

# Frontend Base URL for Email Links & CORS
FRONTEND_URL=https://codeshield2026.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://codeshield2026.vercel.app

# Groq API Configuration for AI Assistant Chatbot
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
